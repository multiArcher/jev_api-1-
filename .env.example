TZ=Asia/Shanghai

# 本服务只负责这一条艇；必须按每次测试填写。
PLATFORM_ID=1010

TASK_BIND_HOST=0.0.0.0
TASK_PORT=18014
SITUATION_GROUP=239.255.0.10
SITUATION_PORT=18010
MULTICAST_INTERFACE=0.0.0.0

# 以当前server源码中的现场参数为准。
ACTION_HOST=192.168.3.126
ACTION_PORT=18123

CONTROL_INTERVAL=1
STATUS_INTERVAL=1
MAX_CYCLES=0
SITUATION_MAX_AGE=2.5
STOP_SPEED_THRESHOLD=0.1
REASSEMBLY_TIMEOUT=3
MAX_CONSECUTIVE_ERRORS=3
COMMAND_HOLD_TIMEOUT=5

# 默认 Kev-4B；切换远程 Jev 时设置 POLICY_BACKEND=jev 并填写密钥。
POLICY_BACKEND=kev
KEV_ENDPOINT=http://127.0.0.1:18028/v1/systemone
KEV_TIMEOUT=120
MAX_TURN_RATE_DEG_S=45
# 仅在静止且态势未提供targetCourse时填写备用方向；有效态势航向优先。
INITIAL_COURSE_DEG=

JEV_API_KEY=
JEV_ENDPOINT=https://api.jevcn.cn/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT=10

SPEED_UNIT=knots
MAX_SPEED_KNOTS=50
STATIC_OBSTACLE_RADIUS_M=80
VESSEL_LENGTH_M=11.6
VESSEL_WIDTH_M=3.4
STATIC_OBSTACLE_MARGIN_M=0
SPEED_TRANSITION_TIME=0.5
COURSE_TRANSITION_TIME=0.5

# 国内 Jev 地址通常不需要代理；目标服务器无代理时保持为空。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
